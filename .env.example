# J & T Tackle — environment template.
# Copy to `.env` for local work, and set these as secrets in Render for prod.
# Never commit real values.

# --- Database (Supabase Postgres) ---
# Runtime connection: Supabase "Connection pooling" string (Transaction mode,
# port 6543). Append ?pgbouncer=true&connection_limit=1 for serverless-style use.
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Migrations connection: Supabase "Direct connection" string (port 5432).
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# --- App ---
NODE_ENV="development"

# --- Phase 2 (not required to boot the site) ---
# STRIPE_SECRET_KEY=""
# STRIPE_WEBHOOK_SECRET=""
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
