# J & T Tackle — environment template.
# Copy to `.env` for local work, and set these as secrets in Render for prod.
# Never commit real values.

# --- Database (Supabase Postgres) ---
# Runtime connection: Supabase "Connection pooling" string (Transaction mode,
# port 6543). Append ?pgbouncer=true&connection_limit=1 for serverless-style use.
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Migrations connection: Supabase "Direct connection" string (port 5432).
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# --- App ---
NODE_ENV="development"

# --- Phase 2 (not required to boot the site) ---
# STRIPE_SECRET_KEY=""
# STRIPE_WEBHOOK_SECRET=""
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# --- Email list / newsletter ("Join the crew" signup) ---
# Generic provider webhook the /api/subscribe route POSTs new signups to.
# Works with Mailchimp, Klaviyo, Buttondown, ConvertKit, or a Zapier/Make hook —
# each receives { email, source, tags, subscribedAt } as JSON.
# Leave unset in dev: signups still succeed and are logged, nothing is lost.
# NEWSLETTER_WEBHOOK_URL=""
